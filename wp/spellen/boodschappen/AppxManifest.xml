<?xml version="1.0" encoding="utf-8"?>
<!-- Ron Jans' Boodschappenlijst voor Windows 10 Mobile (hosted web app): opent https://boodschappen.timvanbergen.nl/ (~/boodschappenlijst, ES5).
     De lijst staat alleen op de telefoon (localStorage).
     WindowsRuntimeAccess="all": terugknop, statusbalk en toetsenbord van de telefoon.
     Toko bouwt dit pakket (.github/workflows/wp.yml) en ziet aan Version dat er een update is; verhoog die alleen bij een nieuw pakket. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="TimvanBergen.Boodschappenlijst" Publisher="CN=Tim van Bergen" Version="1.0.0.0" ProcessorArchitecture="neutral" />
  <mp:PhoneIdentity PhoneProductId="02666e8a-fadf-4f51-a2f0-6a73f5e6126c" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Ron Jans' Boodschappenlijst</DisplayName>
    <PublisherDisplayName>Tim van Bergen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nl-NL" />
  </Resources>
  <Applications>
    <Application Id="App" StartPage="https://boodschappen.timvanbergen.nl/">
      <uap:VisualElements DisplayName="Ron Jans' Boodschappenlijst" Description="Een boodschappenlijstje met prijzen en het totaal." BackgroundColor="#2e6b34"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Boodschappen" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#2e6b34" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <uap:ApplicationContentUriRules>
        <uap:Rule Match="https://boodschappen.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
      </uap:ApplicationContentUriRules>
      <Extensions>
        <!-- zo kan Toko de app openen -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tvb-boodschappen">
            <uap:DisplayName>Boodschappen</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
