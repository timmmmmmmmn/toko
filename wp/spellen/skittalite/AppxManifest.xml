<?xml version="1.0" encoding="utf-8"?>
<!-- Skitta Lite voor Windows 10 Mobile (hosted web app): opent https://skittalite.timvanbergen.nl/ (skitta/public/lite, ES5, draait zo in Edge 14).
     Heette eerst Belliechat: de pakketnaam blijft TimvanBergen.Belliechat, zodat een geïnstalleerde app gewoon bijwerkt.
     WindowsRuntimeAccess="all": de app gebruikt de terugknop, de statusbalk, het toetsenbord (InputPane) en meldingen van de telefoon.
     bg.js is een achtergrondtaak (elk kwartier) die meldt als er nieuwe berichten zijn; microfoon en webcam zijn voor bellen.
     Toko bouwt dit pakket (.github/workflows/wp.yml) en ziet aan Version dat er een update is; verhoog die alleen bij een nieuw pakket. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="TimvanBergen.Belliechat" Publisher="CN=Tim van Bergen" Version="1.0.2.0" ProcessorArchitecture="neutral" />
  <mp:PhoneIdentity PhoneProductId="0195f29f-4822-456a-9272-cc8f7439325f" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Skitta Lite</DisplayName>
    <PublisherDisplayName>Tim van Bergen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nl-NL" />
  </Resources>
  <Applications>
    <Application Id="App" StartPage="https://skittalite.timvanbergen.nl/">
      <uap:VisualElements DisplayName="Skitta Lite" Description="De lichte versie van Skitta: chatten, foto's en video's sturen." BackgroundColor="#000EB6"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Skitta Lite" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000EB6" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <uap:ApplicationContentUriRules>
        <uap:Rule Match="https://skittalite.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
      </uap:ApplicationContentUriRules>
      <Extensions>
        <Extension Category="windows.backgroundTasks" StartPage="bg.js">
          <BackgroundTasks>
            <Task Type="timer" />
          </BackgroundTasks>
        </Extension>
        <!-- zo kan Toko de app openen -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tvb-skittalite">
            <uap:DisplayName>Skitta Lite</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
