<?xml version="1.0" encoding="utf-8"?>
<!-- Woesoe (heette eerst Wierie) voor Windows 10 Mobile (hosted web app): opent https://woesoe.timvanbergen.nl/ (~/wierie, ES5).
     De pakketnaam blijft TimvanBergen.Wierie, zodat een geïnstalleerde app gewoon bijwerkt.
     location: het weer waar je bent.
     WindowsRuntimeAccess="all": terugknop, statusbalk en volledig scherm.
     Toko bouwt dit pakket (.github/workflows/wp.yml) en ziet aan Version dat er een update is; verhoog die alleen bij een nieuw pakket. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="TimvanBergen.Wierie" Publisher="CN=Tim van Bergen" Version="1.0.1.0" ProcessorArchitecture="neutral" />
  <mp:PhoneIdentity PhoneProductId="8595c57c-f6bf-49a7-babb-f78ac78b3649" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Woesoe</DisplayName>
    <PublisherDisplayName>Tim van Bergen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nl-NL" />
  </Resources>
  <Applications>
    <Application Id="App" StartPage="https://woesoe.timvanbergen.nl/">
      <uap:VisualElements DisplayName="Woesoe" Description="Het weer, maar dan in straattaal." BackgroundColor="#9fb4c8"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Woesoe" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#9fb4c8" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <uap:ApplicationContentUriRules>
        <uap:Rule Match="https://woesoe.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
        <uap:Rule Match="https://wierie.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
      </uap:ApplicationContentUriRules>
      <Extensions>
        <!-- zo kan Toko de app openen -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tvb-woesoe">
            <uap:DisplayName>Woesoe</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
