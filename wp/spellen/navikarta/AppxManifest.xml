<?xml version="1.0" encoding="utf-8"?>
<!-- Navi Karta voor Windows 10 Mobile (hosted web app): opent https://navikarta.timvanbergen.nl/ (~/navikarta, ES5 + Leaflet 1.9.4).
     location: voor je plek op de kaart en navigeren.
     WindowsRuntimeAccess="all": terugknop, statusbalk en toetsenbord van de telefoon.
     Toko bouwt dit pakket (.github/workflows/wp.yml) en ziet aan Version dat er een update is; verhoog die alleen bij een nieuw pakket. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="TimvanBergen.NaviKarta" Publisher="CN=Tim van Bergen" Version="1.0.1.0" ProcessorArchitecture="neutral" />
  <mp:PhoneIdentity PhoneProductId="02232cbc-b82c-4d47-b625-41f6fce340f5" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Navi Karta</DisplayName>
    <PublisherDisplayName>Tim van Bergen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nl-NL" />
  </Resources>
  <Applications>
    <Application Id="App" StartPage="https://navikarta.timvanbergen.nl/">
      <uap:VisualElements DisplayName="Navi Karta" Description="Kaarten, zoeken en routes, licht genoeg voor je Lumia." BackgroundColor="#10316b"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Navi Karta" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#10316b" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <uap:ApplicationContentUriRules>
        <uap:Rule Match="https://navikarta.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
      </uap:ApplicationContentUriRules>
      <Extensions>
        <!-- zo kan Toko de app openen -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tvb-navikarta">
            <uap:DisplayName>Navi Karta</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
