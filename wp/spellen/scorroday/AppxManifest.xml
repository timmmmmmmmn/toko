<?xml version="1.0" encoding="utf-8"?>
<!-- Scorroday voor Windows 10 Mobile (hosted web app): opent https://scorroday.timvanbergen.nl/ (~/scorroday, ES5, draait zo in Edge 14).
     Inloggen bij SOMtoday gebeurt in een x-ms-webview in de app; lukt dat niet, dan in Edge, en SOMtoday stuurt je terug via
     somtoday://… (protocol hieronder), waarmee Windows Scorroday weer opent met de code.
     WindowsRuntimeAccess="all": terugknop, statusbalk en toetsenbord van de telefoon.
     Toko bouwt dit pakket (.github/workflows/wp.yml) en ziet aan Version dat er een update is; verhoog die alleen bij een nieuw pakket. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="TimvanBergen.Scorroday" Publisher="CN=Tim van Bergen" Version="1.0.1.0" ProcessorArchitecture="neutral" />
  <mp:PhoneIdentity PhoneProductId="4cfa914f-c412-4898-8682-f141e2462bd1" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Scorroday</DisplayName>
    <PublisherDisplayName>Tim van Bergen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nl-NL" />
  </Resources>
  <Applications>
    <Application Id="App" StartPage="https://scorroday.timvanbergen.nl/">
      <uap:VisualElements DisplayName="Scorroday" Description="Je SOMtoday-rooster, licht en snel." BackgroundColor="#25C5FF"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Scorroday" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#25C5FF" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <uap:ApplicationContentUriRules>
        <uap:Rule Match="https://scorroday.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
      </uap:ApplicationContentUriRules>
      <Extensions>
        <!-- zo kan Toko de app openen -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tvb-scorroday">
            <uap:DisplayName>Scorroday</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- terugkomen na inloggen bij SOMtoday in Edge -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="somtoday">
            <uap:DisplayName>Scorroday</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
