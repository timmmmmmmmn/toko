<?xml version="1.0" encoding="utf-8"?>
<!-- BuckMe voor Windows 10 Mobile (hosted web app): opent https://buckme.timvanbergen.nl/ (~/buckme, ES5).
     Alles is nepgeld (Bucks) en staat alleen op de telefoon (localStorage).
     WindowsRuntimeAccess="all": terugknop, statusbalk en toetsenbord van de telefoon.
     Toko bouwt dit pakket (.github/workflows/wp.yml) en ziet aan Version dat er een update is; verhoog die alleen bij een nieuw pakket. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="TimvanBergen.BuckMe" Publisher="CN=Tim van Bergen" Version="1.0.0.0" ProcessorArchitecture="neutral" />
  <mp:PhoneIdentity PhoneProductId="b2af3a4e-0d19-4a52-9688-3fc95da83ae7" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>BuckMe</DisplayName>
    <PublisherDisplayName>Tim van Bergen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="nl-NL" />
  </Resources>
  <Applications>
    <Application Id="App" StartPage="https://buckme.timvanbergen.nl/">
      <uap:VisualElements DisplayName="BuckMe" Description="Nep-bank en casino met speelgeld." BackgroundColor="#6a2ee8"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" ShortName="BuckMe" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#6a2ee8" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="portrait" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
      <uap:ApplicationContentUriRules>
        <uap:Rule Match="https://buckme.timvanbergen.nl/" Type="include" WindowsRuntimeAccess="all" />
      </uap:ApplicationContentUriRules>
      <Extensions>
        <!-- zo kan Toko de app openen -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tvb-buckme">
            <uap:DisplayName>BuckMe</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
